# Configuration interface for The Wildlife Desk.
# Keep live configuration in an ignored .env or deployment secret store.
WILDLIFE_SOURCE_MODE=immich
IMMICH_BASE_URL=https://immich.example.invalid
IMMICH_API_KEY=
IMMICH_WILDLIFE_ALBUM_ID=

# Explicit local directory selection when WILDLIFE_SOURCE_MODE=local
LOCAL_WILDLIFE_DIR=
BURST_WINDOW_SECONDS=180

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_STAGE_DIR=
INSTAGRAM_STAGE_BASE_URL=
PUBLISH_ENABLED=false
MAX_POSTS_PER_DAY=1
MAX_MODEL_CALLS_PER_RUN=10
MAX_MODEL_COST_PER_RUN_USD=1.00

TIMEZONE=UTC
STATE_DIR=./state
OUTPUT_DIR=./output
LOCAL_SERVER_PORT=8766
LOG_LEVEL=INFO
